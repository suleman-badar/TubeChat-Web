# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL connection string.
# Example (Neon):
# postgresql://username:password@host/database?sslmode=require
DATABASE_URL=

# ============================================================
# AI Provider Configuration
# ============================================================

# Google Gemini API Key
# Get one from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq API Key
# Get one from: https://console.groq.com/keys
GROQ_API_KEY=

# ============================================================
# External APIs
# ============================================================

# API token used for fetching restaurant/location data.HD
# Replace with your own token from the provider.
HD_TOKEN=

# ============================================================
# Authentication
# ============================================================

# Secret key used to sign and verify JWTs.
# Generate a long random string (32+ characters recommended).
#
# Example:
# openssl rand -hex 32
JWT_SECRET_KEY=

# ============================================================
# Paddle Billing Configuration
# ============================================================

# Paddle Client-side Token
# Dashboard → Developer Tools → Client-side Tokens
PADDLE_CLIENT_SIDE_TOKEN=

# Paddle Environment
# Allowed values:
#   sandbox
#   production
PADDLE_ENVIRONMENT=sandbox

# Paddle Price ID for the Pro subscription plan.
# Example:
# pri_01xxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRO_PRICE_ID=

# Paddle Webhook Secret
# Dashboard → Developer Tools → Notification Destinations
PADDLE_WEBHOOK_SECRET=

# ============================================================
# Optional Configuration
# ============================================================


# ============================================================
# Notes
# ============================================================
#
# 1. Copy this file and rename it to ".env".
#
# 2. Never commit your actual ".env" file to GitHub.
#
# 3. Keep your API keys and secrets private.
#
# 4. Make sure ".env" is included in your .gitignore.
#